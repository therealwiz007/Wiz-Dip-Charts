<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: cloud backup and device-to-device transfer of the user's own data only. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="tankdip_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="tankdip_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
